# ==============================================
# NOVA Electronics Store - Backend Configuration
# ==============================================
# Copy this file to .env and fill in the values.

# ---------------------
# Database (PostgreSQL)
# ---------------------
DATABASE_URL=postgres://dbUser:dbUserPassword!@localhost:5432/dbName$

# ---------------------
# Redis
# ---------------------
REDIS_URL=redis://localhost:6379

# ---------------------
# Authentication
# ---------------------
# REQUIRED in production (NODE_ENV=production) - the app refuses to boot without
# these set. In dev, unset falls back to a placeholder value.
# Generate with: openssl rand -hex 32
JWT_SECRET=supersecret_jwt_change_me
COOKIE_SECRET=supersecret_cookie_change_me

# ---------------------
# Stripe (Payment)
# ---------------------
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Set to "true" to enable the auto-authorizing test/system payment provider
# (no real payment is collected - dev/staging only). Defaults to true when
# NODE_ENV isn't "production", and false in production. Do NOT set to "true"
# on a live production deployment.
# ALLOW_TEST_PAYMENTS=true

# ---------------------
# CORS
# ---------------------
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# ---------------------
# Backend
# ---------------------
# Production example: https://api.novastore.com.ua
MEDUSA_BACKEND_URL=http://localhost:9000
PORT=9000

# ---------------------
# Storefront cache revalidation (admin changes -> storefront)
# ---------------------
# Must match the storefront's REVALIDATE_SECRET env var.
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=change_me_shared_revalidate_secret

# ---------------------
# Transactional emails (welcome, order confirmation, shipment) - see docs/MAIL.md
# ---------------------
# Mail notifications
# ---------------------
ORDER_EMAIL_FROM=test@mail.com
# Abandoned-cart cron job (src/jobs/abandoned-cart-email.ts). Prod: leave
# ABANDONED_CART_SCHEDULE unset (hourly) and set ABANDONED_CART_HOURS=1.
# ABANDONED_CART_SCHEDULE=0 * * * *
# ABANDONED_CART_HOURS=1
# ABANDONED_CART_EMAIL=false

# ---------------------
# Admin
# ---------------------
MEDUSA_ADMIN_ONBOARDING_TYPE=default

DB_NAME=